{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Number of items stored"
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Index into the request's array"
          },
          "reason": {
            "type": "string",
            "enum": [
              "invalid_snapshot",
              "unknown_provider",
              "observed_at_out_of_range"
            ]
          }
        },
        "required": [
          "index",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "serverTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "UTC instant, ISO 8601 with a Z suffix"
    },
    "nextSyncAfterSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Earliest time for the next sync, in seconds"
    },
    "paused": {
      "type": "boolean",
      "description": "True when the account has paused syncing on tokenwat.ch: nothing was stored and accepted is 0. Keep syncing on schedule; storing resumes once the user unpauses."
    }
  },
  "required": [
    "accepted",
    "rejected",
    "serverTime",
    "nextSyncAfterSeconds",
    "paused"
  ],
  "additionalProperties": false,
  "title": "PUT /v1/plans 200 response, v1"
}
